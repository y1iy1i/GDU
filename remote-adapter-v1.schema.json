{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gdu-research.local/schema/remote-adapter-v1.schema.json",
  "title": "GDU OpenAI-compatible remote transport v1 configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["enabled"],
  "properties": {
    "enabled": { "type": "boolean" },
    "provider_id": { "type": "string", "minLength": 1 },
    "base_url": { "type": "string", "pattern": "^https://[^\\s/]+(?:/[^\\s]*)?$" },
    "model": { "type": "string", "minLength": 1 },
    "api_key_env": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
    "api_style": { "const": "openai_chat_completions" },
    "max_calls": { "type": "integer", "minimum": 1, "maximum": 8 },
    "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 120 },
    "max_output_tokens": { "type": "integer", "minimum": 1, "maximum": 8192 },
    "temperature": { "const": 0 },
    "authorization_id": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "enabled": { "const": true } } },
      "then": {
        "required": [
          "provider_id", "base_url", "model", "api_key_env", "api_style",
          "max_calls", "timeout_seconds", "max_output_tokens", "temperature",
          "authorization_id"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            { "required": ["api_key_env"] },
            { "required": ["authorization_id"] }
          ]
        }
      }
    }
  ]
}
